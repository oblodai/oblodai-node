# One API key per merchant: the same pair signs payments and payouts, settings and documents.
# Start in the sandbox — a sandbox pair is test_oblodai_<hex> / oblodai_test_<hex> and drives a
# chainless copy of the gateway (sandbox.faucet, sandbox.deposit). A live pair is oblodai_<hex> /
# oblodai_live_<hex>, issued in the dashboard at my.oblodai.com -> API keys.
OBLODAI_PUBLIC_ID=oblodai_xxx
OBLODAI_SECRET=oblodai_live_xxx
# Webhook signing secret, returned once by webhooks.register() / rotateSecret().
OBLODAI_WEBHOOK_SECRET=xxx
# OBLODAI_BASE_URL=https://api.oblodai.com
# OBLODAI_ALLOW_INSECURE=1   # permit http:// for a self-hosted/local core
# OBLODAI_LOG=debug          # debug | info | warn | error
# OBLODAI_ADMIN_TOKEN=xxx    # self-hosted gateway only: sent as X-Admin-Token on merchant provisioning
