# Start in the sandbox: a test key looks like test_… / oblodai_test_… and drives a chainless copy
# of the gateway (sandbox.faucet, sandbox.deposit). Live keys: pk_live_… (payment) and wk_live_… (payout).
OBLODAI_PUBLIC_ID=pk_live_xxx
OBLODAI_SECRET=xxx
# Payout key — required for payouts, refunds, payout links, transfers, splits, auto-withdraw, allow-list.
OBLODAI_PAYOUT_PUBLIC_ID=wk_live_xxx
OBLODAI_PAYOUT_SECRET=xxx
# Webhook signing secret, returned once by webhooks.register() / rotateSecret().
OBLODAI_WEBHOOK_SECRET=xxx
# OBLODAI_BASE_URL=https://api.oblodai.com
# OBLODAI_ALLOW_INSECURE=1   # permit http:// for a self-hosted/local core
# OBLODAI_LOG=debug          # debug | info | warn | error
# OBLODAI_ADMIN_TOKEN=xxx    # self-hosted gateway only: sent as X-Admin-Token on merchant provisioning
