{
  "name": "@oblodai-npm/sdk",
  "version": "1.2.0",
  "description": "Официальный TypeScript/Node.js SDK для платёжного шлюза Oblodai: приём платежей, выплаты, статические кошельки, вебхуки.",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    ".env.example"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "oblodai",
    "crypto",
    "payments",
    "payout",
    "cryptocurrency",
    "usdt",
    "webhook",
    "payment-gateway"
  ],
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "author": "Oblodai",
  "homepage": "https://github.com/oblodai/oblodai-node#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/oblodai/oblodai-node.git"
  },
  "bugs": {
    "url": "https://github.com/oblodai/oblodai-node/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@types/node": "^20.12.0"
  },
  "devDependencies": {
    "tsup": "^8.0.0",
    "typescript": "^5.4.0",
    "vitest": "^1.6.0"
  }
}
