{
  "name": "@oblodai-npm/sdk",
  "version": "2.0.0",
  "description": "Official TypeScript/Node.js SDK for the Oblodai payment gateway: payment acceptance, payouts, static wallets, webhooks.",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/types/esm/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/types/esm/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/types/cjs/index.d.ts",
        "default": "./dist/index.cjs"
      }
    },
    "./webhooks": {
      "import": {
        "types": "./dist/types/esm/webhooks.d.ts",
        "default": "./dist/webhooks.js"
      },
      "require": {
        "types": "./dist/types/cjs/webhooks.d.ts",
        "default": "./dist/webhooks.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "AGENTS.md",
    "README.md",
    "CHANGELOG.md",
    "MIGRATION-2.0.md",
    "LICENSE"
  ],
  "scripts": {
    "check-generated": "node scripts/check-generated.mjs",
    "build": "tsup && node scripts/build-types.mjs",
    "typecheck": "tsc --noEmit && tsc -p test/tsconfig.json && tsc -p examples/tsconfig.json",
    "test": "vitest run",
    "test:live": "OBLODAI_LIVE_URL=${OBLODAI_LIVE_URL:-http://localhost:8095} vitest run test/live",
    "check-package": "node scripts/check-package.mjs",
    "fmt": "prettier --write .",
    "fmt:check": "prettier --check .",
    "ci": "npm run fmt:check && npm run check-generated && npm run typecheck && npm test && npm run build && npm run check-package",
    "prepublishOnly": "npm run ci"
  },
  "keywords": [
    "oblodai",
    "crypto",
    "payments",
    "payout",
    "cryptocurrency",
    "usdt",
    "webhook",
    "payment-gateway"
  ],
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "author": "Oblodai",
  "homepage": "https://github.com/oblodai/oblodai-node#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/oblodai/oblodai-node.git"
  },
  "bugs": {
    "url": "https://github.com/oblodai/oblodai-node/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@types/node": "^20.12.0",
    "prettier": "^3.9.6",
    "tsup": "^8.0.0",
    "typescript": "^5.4.0",
    "vitest": "^1.6.0",
    "@types/express": "^4.17.21",
    "express": "^4.19.2",
    "tsx": "^4.19.0"
  }
}
